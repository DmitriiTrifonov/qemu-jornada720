 #include "ui/input.h"
 #include "ui/sdl2.h"
 
+/*
+ * qemu-jornada720: QEMU_SDL_SCALE (see sdl2_2d_switch) picks how the guest
+ * screen is scaled to the window:
+ *   integer - whole factors only: sharp, may leave borders
+ *   linear  - smooth
+ *   sharp   - "sharp bilinear": nearest to the largest whole factor that
+ *             fits, then linear for the rest; nearly as crisp as integer
+ *             and fills the window
+ * Any of them also makes the window high-DPI (see sdl2_window_create),
+ * so scaling happens at the screen's real resolution.
+ */
+static bool sdl2_scale_mode(const char *mode)
+{
+    const char *m = getenv("QEMU_SDL_SCALE");
+
+    return m && !strcmp(m, mode);
+}
+
+static void sdl2_2d_draw(struct sdl2_console *scon)
+{
+    SDL_Renderer *r = scon->real_renderer;
+    SDL_Texture *src = scon->texture;
+    int w = surface_width(scon->surface), h = surface_height(scon->surface);
+    int ow, oh, k;
+
+    if (sdl2_scale_mode("sharp") && SDL_RenderTargetSupported(r) &&
+        SDL_GetRendererOutputSize(r, &ow, &oh) == 0) {
+        k = MAX(1, MIN(ow / w, oh / h));
+        if (scon->sharp_target && scon->sharp_factor != k) {
+            SDL_DestroyTexture(scon->sharp_target);
+            scon->sharp_target = NULL;
+        }
+        if (!scon->sharp_target) {
+            scon->sharp_target = SDL_CreateTexture(r, SDL_PIXELFORMAT_ARGB8888,
+                                                   SDL_TEXTUREACCESS_TARGET,
+                                                   w * k, h * k);
+            scon->sharp_factor = k;
+            if (scon->sharp_target) {
+                SDL_SetTextureScaleMode(scon->sharp_target,
+                                        SDL_ScaleModeLinear);
+            }
+        }
+        if (scon->sharp_target &&
+            SDL_SetRenderTarget(r, scon->sharp_target) == 0) {
+            SDL_RenderCopy(r, src, NULL, NULL);
+            SDL_SetRenderTarget(r, NULL);
+            src = scon->sharp_target;
+        }
+    }
+    SDL_RenderClear(r);
+    SDL_RenderCopy(r, src, NULL, NULL);
+    SDL_RenderPresent(r);
+}
+
 void sdl2_2d_update(DisplayChangeListener *dcl,
                     int x, int y, int w, int h)
 {
