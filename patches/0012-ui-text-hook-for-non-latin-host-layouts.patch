+/*
+ * qemu-jornada720: with a text hook set (see qemu_input_set_text_hook),
+ * printable keys go to the guest as the characters the host layout makes
+ * of them when that layout is not Latin (e.g. Russian), so the guest
+ * need not have that layout itself. Shortcuts with Ctrl/Alt/Super, space
+ * and non-printing keys still go as key events.
+ */
+static bool sdl2_text_routed;
+
+static bool sdl2_route_as_text(SDL_KeyboardEvent *key)
+{
+    SDL_Keycode sym = SDL_GetKeyFromScancode(key->keysym.scancode);
+    bool latin = SDL_GetKeyFromScancode(SDL_SCANCODE_A) < 0x80;
+
+    if (!qemu_input_text_hook_active() ||
+        (key->keysym.mod & (KMOD_CTRL | KMOD_ALT | KMOD_GUI)) ||
+        (sym & SDLK_SCANCODE_MASK) || sym <= 0x20 || sym == 0x7f) {
+        return false;
+    }
+    return sym >= 0xa0 || !latin;
+}
