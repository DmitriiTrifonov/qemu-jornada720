                              const char *device_id, int head,
                              Error **errp);
 void qemu_input_event_send(QemuConsole *src, QemuInputEvent *evt);
+
+/*
+ * qemu-jornada720: characters the host keyboard layout produces that the
+ * guest's own layout cannot (e.g. Cyrillic), as Unicode code points, for
+ * a board that can type them some other way. The SDL UI sends such keys
+ * here instead of as key events while a hook is set.
+ */
+typedef void QemuInputTextHook(void *opaque, uint32_t codepoint);
+void qemu_input_set_text_hook(QemuInputTextHook *hook, void *opaque);
+bool qemu_input_text_hook_active(void);
+void qemu_input_send_text(uint32_t codepoint);
 void qemu_input_event_send_impl(QemuConsole *src, QemuInputEvent *evt);
 void qemu_input_event_sync(void);
 void qemu_input_event_sync_impl(void);
diff --git a/ui/input.c b/ui/input.c
--- a/ui/input.c
+++ b/ui/input.c
@@ -714,3 +714,25 @@
     }
     g_free(up);
 }
+
+static QemuInputTextHook *text_hook;
+static void *text_hook_opaque;
+
+void qemu_input_set_text_hook(QemuInputTextHook *hook, void *opaque)
+{
+    text_hook = hook;
+    text_hook_opaque = opaque;
+}
+
+bool qemu_input_text_hook_active(void)
+{
+    return text_hook != NULL;
+}
+
+void qemu_input_send_text(uint32_t codepoint)
+{
+    if (text_hook && (runstate_is_running() ||
+                      runstate_check(RUN_STATE_SUSPENDED))) {
+        text_hook(text_hook_opaque, codepoint);
+    }
+}
diff --git a/ui/sdl2.c b/ui/sdl2.c
--- a/ui/sdl2.c
+++ b/ui/sdl2.c
@@ -395,6 +395,28 @@
     }
