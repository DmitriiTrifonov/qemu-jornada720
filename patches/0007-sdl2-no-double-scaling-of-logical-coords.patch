+/*
+ * Local experiment for the qemu-jornada720 project: the 2D renderer sets
+ * SDL_RenderSetLogicalSize() to the guest surface size, and SDL2 then
+ * already delivers mouse (and touch-synthesised mouse) coordinates in
+ * that logical space, letterboxing included. Scaling them again by the
+ * window size squashes them towards the top-left corner as soon as the
+ * window is bigger than the guest screen (e.g. fullscreen on a phone).
+ */
+static bool sdl2_coords_are_logical(struct sdl2_console *scon)
+{
+    int lw = 0, lh = 0;
+
+    if (scon->real_renderer) {
+        SDL_RenderGetLogicalSize(scon->real_renderer, &lw, &lh);
+    }
+    return lw > 0 && lh > 0;
+}
