diff --git a/hw/arm/strongarm.c b/hw/arm/strongarm.c
index 5a32421..b57c3f4 100644
--- a/hw/arm/strongarm.c
+++ b/hw/arm/strongarm.c
@@ -1391,12 +1391,24 @@ struct StrongARMSSPState {
 #define SSCR1_RIE       (1 << 0)
 #define SSCR1_TIE       (1 << 1)
 #define SSCR1_LBM       (1 << 2)
-#define SSSR_TNF        (1 << 2)
-#define SSSR_RNE        (1 << 3)
-#define SSSR_TFS        (1 << 5)
-#define SSSR_RFS        (1 << 6)
-#define SSSR_ROR        (1 << 7)
-#define SSSR_RW         0x0080
+/*
+ * Bit positions corrected against the real SA-1110 Developer's Manual
+ * (section 11.12.12, SSSR register map: bit1=TNF, bit2=RNE, bit3=BSY,
+ * bit4=TFS, bit5=RFS, bit6=ROR) -- these were previously one bit lower
+ * (2/3/5/6/7), apparently copied from PXA25x's SSP which uses a
+ * different layout. Found by tracing a real Jornada 720 ROM: its boot
+ * code polls TNF/RNE at the positions the real datasheet specifies, and
+ * hung forever against the old (wrong) bit positions. Local fix for the
+ * qemu-jornada720 project; not verified against real PXA hardware, so
+ * not applied there.
+ */
+#define SSSR_TNF        (1 << 1)
+#define SSSR_RNE        (1 << 2)
+#define SSSR_BSY        (1 << 3)
+#define SSSR_TFS        (1 << 4)
+#define SSSR_RFS        (1 << 5)
+#define SSSR_ROR        (1 << 6)
+#define SSSR_RW         0x0040
 
 static void strongarm_ssp_int_update(StrongARMSSPState *s)
 {
