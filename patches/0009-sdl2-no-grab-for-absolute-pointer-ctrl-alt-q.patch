+++ b/ui/sdl2.c
@@ -256,6 +256,15 @@
         return;
     }
     /*
+     * Local experiment for the qemu-jornada720 project: an absolute
+     * pointer (touchscreen/tablet) needs no grab, and grabbing also grabs
+     * the keyboard (SDL_HINT_GRAB_KEYBOARD), which on Wayland inhibits all
+     * compositor shortcuts -- the user could not even close the window.
+     */
+    if (qemu_input_is_absolute(con)) {
+        return;
+    }
+    /*
      * If the application is not active, do not try to enter grab state. This
      * prevents 'SDL_WM_GrabInput(SDL_GRAB_ON)' from blocking all the
      * application (SDL bug).
@@ -375,6 +384,12 @@
             (gui_grab_code | KMOD_LSHIFT);
     } else if (ctrl_grab) {
         return (mod & KMOD_RCTRL) == KMOD_RCTRL;
+    } else if (gui_grab_code == (KMOD_LALT | KMOD_LCTRL)) {
+        /*
+         * qemu-jornada720: accept Ctrl and Alt of either side; some
+         * keyboards send RightAlt for their only Alt key.
+         */
+        return (mod & KMOD_CTRL) && (mod & KMOD_ALT);
     } else {
         return (mod & gui_grab_code) == gui_grab_code;
     }
